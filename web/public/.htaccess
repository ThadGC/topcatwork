# ============================================================================
# Topcat Worktops — Apache rules for the SiteGround host (29 August 2026)
#
# ⛔ THIS FILE IS THE ONLY PART OF THE FIX THAT REACHES THE LIVE SITE.
#
# topcatworktops.co.uk is a STATIC SNAPSHOT of this build, uploaded to
# SiteGround by hand. Vercel is where the app runs; SiteGround is where the
# customer lands. Apache knows nothing about next.config.ts, so the redirects
# and rewrites declared there fix the Vercel copy and NOTHING on the live
# domain. These rules are their Apache equivalent and must be uploaded WITH
# the site files, at the web root, or the two problems below come straight
# back.
#
# ---------------------------------------------------------------------------
# PROBLEM 1 — every extensionless URL returned 403 on the live host
# ---------------------------------------------------------------------------
# Measured 29 Aug, live domain against the Vercel copy:
#
#   /stone-selector           403   (Vercel 200)
#   /stones/compare           403   (Vercel 200)
#   /services/outdoor-kitchens 403  (Vercel 200)
#   /stone-selector.html      200
#   /estimate                 200   ← the exception, and it is the clue
#
# The export writes most routes as a FLAT file — `stone-selector.html` — and a
# few as a DIRECTORY with an index inside. Apache serves the directory ones
# from their index and has nothing to answer with for the flat ones, so the
# clean URL fails. It fails 403 rather than 404 because directory indexing is
# refused on this host; the page is not forbidden, it was never found.
#
# The rewrite below tries `<path>.html` for any request that is not already a
# real file or directory, which makes every flat-exported route answer at its
# clean URL. That is the whole of the /stone-selector fix.
#
# ---------------------------------------------------------------------------
# PROBLEM 2 — the service pages still resolved at .html
# ---------------------------------------------------------------------------
# The client: "/services/outdoor-kitchens.html should become
# /services/outdoor-kitchens ... and make sure the old .html URLs redirect to
# the new ones rather than 404ing."
#
# ⚠️ ORDER IS LOAD-BEARING. The redirect must come BEFORE the rewrite. Put it
# after and the rewrite answers `/services/x` from `x.html` internally, the
# redirect then matches that rewritten path, and Apache loops until it gives
# up with a 500.
#
# ⛔ AND IT IS SCOPED TO /services/ ONLY. The 132 stone pages, the 9 guides and
# the 5 material pages still declare `.html` canonicals, so redirecting them
# here would advertise one URL and serve another. Those families are a separate
# change; see the handover.
# ============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # -- 0. THE ENQUIRY ENDPOINT IS LEFT ALONE ---------------------------------
  # ⛔ EVERY FORM ON THE SITE POSTS TO /api/enquiry. Rule 2 below would not
  # touch it — `api/enquiry` is a real directory, so its `!-d` test already
  # fails — but that is an accident of the export's shape rather than a
  # decision, and it would stop being true the moment the endpoint moved to a
  # bare `api/enquiry.php`. This says it outright instead, ahead of everything,
  # so a later edit to the rules below cannot silently break every form on the
  # site. DirectoryIndex serves api/enquiry/index.php.
  RewriteRule ^api/ - [L]

  # -- 1. the nine service pages: .html is retired, 301 to the clean URL ------
  # THE_REQUEST is matched, not REQUEST_URI, so this fires only on a real
  # browser request and never on an internal rewrite — belt and braces beside
  # the ordering above.
  RewriteCond %{THE_REQUEST} \s/+services/([a-z-]+)\.html[\s?] [NC]
  RewriteRule ^ /services/%1? [R=301,L]

  # -- 1b. THE ARTICLES ------------------------------------------------------
  # Added 2 September 2026 with the /articles section.
  #
  # Articles are standalone HTML files dropped by hand into `articles/` at the
  # web root. `granite-vs-quartz.html` is served at /articles/granite-vs-quartz
  # by rule 2 below with NO change at all — that fallback already does exactly
  # what these pages need, which is why there is no rule here to serve them.
  #
  # These three rules exist for the two things rule 2 cannot do.
  #
  # (a) RETIRE THE .html LEAF. Each article declares the clean URL as its own
  #     canonical, so the leaf must 301 rather than answer, or one page is
  #     live at two URLs and one of them contradicts its own canonical tag.
  #
  #     ⛔ THE_REQUEST, NOT REQUEST_URI, AND IT IS NOT A STYLE CHOICE.
  #     THE_REQUEST is the immutable first line of the HTTP request, so it
  #     matches only what the browser actually asked for and never rule 2's
  #     internal rewrite. Written with %{REQUEST_URI} this rule is an infinite
  #     301 loop on the CLEAN url — measured, fifty hops and curl gave up —
  #     because rule 2 rewrites /articles/x to /articles/x.html internally and
  #     this rule then matches its own output. Moving it above rule 2 does NOT
  #     save you. Only THE_REQUEST does. This is the same trap the services
  #     rule above documents, and the same defence.
  #
  # (b) RESCUE THE LISTING PAGE, which is the part that is easy to miss.
  #     `articles/` is a REAL DIRECTORY here, unlike every other hub on the
  #     site. mod_dir therefore 301s /articles to /articles/, and rule 2's
  #     `!-d` test then refuses to serve it: measured 403 on this host, where
  #     directory indexing is off. So the slash is turned off for that one
  #     directory in articles/.htaccess, and the two rules below answer
  #     /articles from the flat articles.html the export writes, and send the
  #     slashed form back to the canonical shape.
  #
  #     Result, verified to match the Vercel copy hop for hop:
  #       /articles            200, no redirect
  #       /articles/           301 -> /articles
  #       /articles/<slug>     200
  #       /articles/<slug>.html 301 -> /articles/<slug>
  #
  # ⚠️ DO NOT UPLOAD THE LISTING PAGE WITHOUT AT LEAST ONE ARTICLE FILE. With
  # no `articles/` directory present, rule 2 turns /articles/ and
  # /articles/<anything> into 500s — the same PATH_INFO fault that already
  # affects /stone-selector/x today.
  RewriteCond %{THE_REQUEST} \s/+articles/([a-z0-9-]+)\.html[\s?] [NC]
  RewriteRule ^ /articles/%1? [R=301,L]

  RewriteRule ^articles/$ /articles [R=301,L]
  RewriteRule ^articles$ /articles.html [L]

  # -- 2. serve every flat-exported route at its clean URL -------------------
  # Only when the request is not already a real file or directory, so existing
  # assets, directory-index routes and send.php are untouched.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# ============================================================================
# Cache and compression, carried over from the previous build's .htaccess.
# The reasoning there still holds: the HTML must never be served stale because
# it is what carries the new ?v= stamps for everything else.
# ============================================================================
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header unset Pragma
  </FilesMatch>

  # Next writes content-hashed filenames under /_next/static, so these are
  # genuinely immutable.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # ⛔ THE ARTICLES STYLESHEET IS THE ONE .css THAT IS NOT IMMUTABLE.
  # /_next/static/*.css is content-hashed, so a year is correct for it. The
  # articles sheet is deliberately at a FIXED url — a hand-written article has
  # to be able to <link> something whose name does not change between builds —
  # so a year would freeze every returning visitor on the first version they
  # ever downloaded, with no way out but renaming the file. It carries a ?v=
  # stamp from scripts/build-articles-css.mjs, and an hour here means a stamp
  # that is ever forgotten heals itself instead of lasting twelve months.
  # This block must stay BELOW the .css rule above; last match wins.
  <Files "topcat-articles.css">
    Header set Cache-Control "public, max-age=3600"
  </Files>

  # ⛔ NOT `immutable`. Slab tiles and portraits are named for their subject,
  # not their contents, and rely on a hand-bumped ?v=. An hour is a forgotten
  # bump that heals itself; a year is one that is invisible for twelve months.
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # The film is 17MB on the wide cut and is the first thing a desktop visitor
  # fetches. A week, and it carries a hand-bumped ?v=.
  <FilesMatch "\.(mp4|webm)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
                                application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml \
                                        application/javascript application/json image/svg+xml
</IfModule>

# ============================================================================
# The enquiry endpoint's SMTP credentials. `config.php` is not in the
# repository and is created on the server by hand — see
# api/enquiry/config.example.php. Apache executes .php rather than serving it,
# so this is belt and braces: if the file is ever renamed, backed up as
# config.php.bak or left as a .txt beside it, it must still not be downloadable.
# ============================================================================
<FilesMatch "^config\.(php\..*|bak|txt|old|save|orig)$">
  Require all denied
</FilesMatch>
