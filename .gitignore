# ============================================================================
# `main` IS THE WEBSITE. Nothing else lives here.
#
# Every file in this repo is a file the host serves. Clone it, upload the
# CONTENTS of the folder, and the site is live. There is no build step, no
# source tree beside it and no folder to choose between — that ambiguity is
# what put a stale build on the host for several rounds.
#
# ⛔ THE SOURCE AND THE BUILDERS ARE ON THE `source` BRANCH.
#    `git checkout source` — index.html's uncompressed original, the four page
#    builders, make_upload.py and the HANDOVER decision register are all there,
#    with the full history. Change the site THERE, run the builders, then
#    publish the result onto this branch. Editing files here by hand works, but
#    the next build from `source` will overwrite them.
# ============================================================================

# ─── OS / editor noise ──────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db

# ─── Agent session state ────────────────────────────────────────────────────
.claude/

# ─── Enquiry uploads written by send.php at runtime ─────────────────────────
# ⛔ Customer attachments and the `.failed/` queue of enquiries that could not
#    be mailed. They are created ON THE HOST by real visitors — they are not
#    part of the site and must never be committed or overwritten by an upload.
_enquiry-files/

# vercel — the CLI writes .vercel/project.json when the repo is linked.
# Machine state, not source.
.vercel/

# SMTP credentials for the Apache enquiry endpoint — never committed.
# See web/public/api/enquiry/config.example.php
web/public/api/enquiry/config.php
