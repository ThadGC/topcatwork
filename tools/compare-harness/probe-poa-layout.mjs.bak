/* Geometry of the priced-by-hand panel vs the board beside it.
   Real Chrome; smooth scroll off; screenshot AND numbers (markup lies). */
import { chromium } from 'playwright';
import fs from 'node:fs';

const W = +(process.argv[2] || 1440), H = +(process.argv[3] || 900);
const MAT = process.argv[4] || 'Porcelain';
const TAG = process.argv[5] || `${W}x${H}-${MAT}`;

const b = await chromium.launch({ channel: 'chrome' });
const p = await b.newPage({ viewport: { width: W, height: H } });
await p.addStyleTag?.({}).catch(()=>{});
await p.goto('http://localhost:3000/estimate', { waitUntil: 'domcontentloaded' });
await p.addStyleTag({ content: '*{scroll-behavior:auto !important}' });
await p.waitForTimeout(1200);

// pick the material tab by TEXT, never class
const tab = p.locator('.mat-tab', { hasText: new RegExp(MAT.split(' ')[0], 'i') }).first();
if (await tab.count()) { await tab.click(); await p.waitForTimeout(700); }

await p.locator(W<981?'#estPoa':'#estPreview').first().scrollIntoViewIfNeeded().catch(()=>{});
await p.waitForTimeout(600);

const geo = await p.evaluate(() => {
  const r = (sel, root=document) => {
    const e = root.querySelector(sel); if (!e) return null;
    const b = e.getBoundingClientRect();
    return { sel, top:+b.top.toFixed(1), bottom:+b.bottom.toFixed(1),
             h:+b.height.toFixed(1), left:+b.left.toFixed(1), w:+b.width.toFixed(1),
             text:(e.textContent||'').trim().slice(0,42) };
  };
  const out = {};
  for (const s of ['.est-panel','.est-poa','.est-poa-rule','.est-poa h3','#estPoaLead',
                   '.est-poa-points','.est-poa-cta','.est-preview','.est-poaslab',
                   '.est-preview .est-out','#estPoaForm']) out[s] = r(s);
  const lis = [...document.querySelectorAll('.est-poa-points li')].map(e=>{
    const b=e.getBoundingClientRect(); return {top:+b.top.toFixed(1),h:+b.height.toFixed(1)};
  });
  const btns = [...document.querySelectorAll('.est-poa-cta a')].map(e=>{
    const b=e.getBoundingClientRect(); const cs=getComputedStyle(e);
    return {text:e.textContent.trim().slice(0,30), top:+b.top.toFixed(1), left:+b.left.toFixed(1),
            w:+b.width.toFixed(1), h:+b.height.toFixed(1), disp:cs.display};
  });
  // the right column's own heading, whatever it is
  const eyebrow = [...document.querySelectorAll('.est-preview *')]
    .filter(e=>/priced by hand/i.test(e.textContent||'') && e.children.length===0)
    .map(e=>{const b=e.getBoundingClientRect();return{t:e.textContent.trim().slice(0,30),top:+b.top.toFixed(1)}});
  const poaH = [...document.querySelectorAll('.est-preview h2,.est-preview h3,.est-preview .est-outbig,.est-preview strong')]
    .map(e=>{const b=e.getBoundingClientRect();return{t:e.textContent.trim().slice(0,34),top:+b.top.toFixed(1),h:+b.height.toFixed(1)}})
    .filter(x=>x.h>0).slice(0,6);
  return { out, lis, btns, eyebrow, poaH };
});

console.log(JSON.stringify(geo, null, 1));
const gap = (a,bb)=> (a&&bb)? +(bb.top-a.bottom).toFixed(1) : null;
const o = geo.out;
console.log('\n--- GAPS in the priced-by-hand panel ---');
console.log('rule  -> h3     :', gap(o['.est-poa-rule'], o['.est-poa h3']));
console.log('h3    -> lead   :', gap(o['.est-poa h3'], o['#estPoaLead']));
console.log('lead  -> points :', gap(o['#estPoaLead'], o['.est-poa-points']));
console.log('points-> cta    :', gap(o['.est-poa-points'], o['.est-poa-cta']));
console.log('panel h / poa h :', o['.est-panel']?.h, '/', o['.est-poa']?.h);
console.log('preview h       :', o['.est-preview']?.h);

fs.mkdirSync('out',{recursive:true});
await p.locator(W<981?'.est-panel':'.est-grid').first().screenshot({ path:`out/poa-${TAG}.png` }).catch(async()=>{
  await p.screenshot({ path:`out/poa-${TAG}.png` });
});
console.log('shot -> out/poa-'+TAG+'.png');
await b.close();
